# ==============================================================================
# Smart Event Management System — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=mysql+pymysql://root:rootpassword@localhost:3306/smart_events_db
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=smart_events_db
MYSQL_USER=root
MYSQL_PASSWORD=rootpassword

# ── JWT / Auth ────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-secret-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── OpenWeatherMap ────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=
# Default location for campus weather (Colombo, Sri Lanka)
WEATHER_DEFAULT_LAT=6.9271
WEATHER_DEFAULT_LON=79.8612

# ── ML Model ──────────────────────────────────────────────────────────────────
MODEL_PATH=app/ml/models

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
